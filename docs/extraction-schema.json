          "strengthens",
          "weakens",
          "neutral"
        ],
        "title": "Relationship Effect",
        "type": "string"
      },
      "visible_from_order": {
        "description": "Earliest persisted episode order at which this resource is visible.",
        "examples": [
          1
        ],
        "minimum": 1,
        "title": "Visible From Order",
        "type": "integer"
      },
      "valid_from_order": {
        "anyOf": [
          {
            "description": "Earliest persisted episode order at which this resource is visible.",
            "examples": [
              1
            ],
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Valid From Order"
      },
      "valid_until_order": {
        "anyOf": [
          {
            "description": "Earliest persisted episode order at which this resource is visible.",
            "examples": [
