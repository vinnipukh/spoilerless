  "source_payload": {
    "additionalProperties": false,
    "description": "Contract for a source record from a future extractor.\n\nPart of the source-connector interface (PREP-04). Defines what a source\nrecord looks like without implementing any retrieval or parsing.",
    "examples": [
      {
        "content_hash": "sha256:def456...",
        "episode_id": "episode:dexter:s01e01",
        "locator": "https://opensubtitles.org/dexter-s01e01",
        "retrieved_at": "2026-07-30T10:00:00Z",
        "source_type": "transcript"
      }
    ],
    "properties": {
      "source_type": {
        "description": "Type of source \u2014 e.g., 'transcript', 'podcast', 'script', 'article'.",
        "title": "Source Type",
        "type": "string"
      },
      "locator": {
        "description": "Stable locator for the source \u2014 URL, DOI, file path, or episode reference.",
        "title": "Locator",
        "type": "string"
      },
      "retrieved_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
