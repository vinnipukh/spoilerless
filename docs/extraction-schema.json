        "maxLength": 4000,
        "minLength": 1,
        "title": "Evidence Text",
        "type": "string"
      },
      "evidence_locator": {
        "description": "Exact location within the source for this evidence text.",
        "title": "Evidence Locator",
        "type": "string"
      },
      "source_type": {
        "description": "Type of source this claim was extracted from.",
        "title": "Source Type",
        "type": "string"
      },
      "source_locator": {
        "description": "Location of the source this claim was extracted from.",
        "title": "Source Locator",
        "type": "string"
      },
      "episode_id": {
        "description": "Stable public identifier.",
        "examples": [
          "character:dexter"
        ],
        "maxLength": 255,
        "minLength": 1,
        "title": "Episode Id",
        "type": "string"
