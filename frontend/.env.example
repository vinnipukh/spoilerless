VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Production API origin (Render-hosted backend). Leave commented/blank for
# local dev, where the Vite proxy handles relative /api calls; Vercel sets
# the real value as a build-time project env var.
# VITE_API_BASE_URL=https://api.spoilerless.net