{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoilerless.local/schemas/benchmark_visualization_schema.json",
  "title": "Phase 10-08 deterministic visualization benchmark result",
  "description": "Shape contract for scripts/benchmark_visualization.py output. Validated by the stdlib subset validator inside that script (spoilerless/tests/test_visualization_baseline.py::test_benchmark_* re-uses the same validator). Subset: type/required/properties/items/enum/const/minimum/maximum/minItems/uniqueItems/additionalProperties. Two documented benchmark-specific extension keywords are used: `enum_items` on an array of objects requires every listed value to appear as an item's `label`; `required_sizes` on the `sizes` array requires the four D-32 scale labels exactly (order-independent, no extras). Hard-gate fields are deterministic product bounds; environment-sensitive measurements live ONLY in `observations` entries carrying environment_sensitive=true and a rationale (D-32/A2).",
  "type": "object",
  "required": [
    "schema_version",
    "generated_by",
    "projection_version",
    "seed",
    "environment",
    "sizes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "generated_by": { "type": "string" },
    "projection_version": { "const": "1.0.0" },
    "seed": { "type": "integer", "minimum": 1 },
    "environment": {
      "type": "object",
      "required": ["network", "database", "llm_provider", "subprocess", "note"],
      "additionalProperties": false,
      "properties": {
        "network": { "const": false },
        "database": { "const": false },
        "llm_provider": { "const": false },
        "subprocess": { "const": false },
        "note": { "type": "string" }
      }
    },
    "sizes": {
      "type": "array",
      "minItems": 4,
      "required_sizes": ["30x50", "75x150", "150x400", "300x1000"],
      "items": { "$ref": "#/$defs/size_block" }
    }
  },
  "$defs": {
    "size_block": {
      "type": "object",
      "required": [
        "size",
        "deterministic",
        "deterministic_fingerprint",
        "hard_gates",
        "observations"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "required": ["nodes", "edges", "label"],
          "additionalProperties": false,
          "properties": {
            "nodes": { "type": "integer", "minimum": 1 },
            "edges": { "type": "integer", "minimum": 1 },
            "label": { "type": "string" }
          }
        },
        "deterministic": { "$ref": "#/$defs/deterministic" },
        "deterministic_fingerprint": { "type": "string", "minLength": 8 },
        "hard_gates": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/gate" }
        },
        "observations": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "deterministic": {
      "type": "object",
      "required": [
        "dataset",
        "payload_bytes",
        "payload_sha256",
        "overview",
        "cumulative_overview",
        "expansion",
        "focus",
        "episode_switch",
        "gates"
      ],
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "type": "object",
          "required": ["node_kinds", "edge_types", "episodes", "claims", "sources", "evidence"],
          "additionalProperties": false,
          "properties": {
            "node_kinds": { "type": "object" },
            "edge_types": { "type": "object" },
            "episodes": { "type": "integer", "minimum": 2 },
            "claims": { "type": "integer", "minimum": 0 },
            "sources": { "type": "integer", "minimum": 1 },
            "evidence": { "type": "integer", "minimum": 0 }
          }
        },
        "payload_bytes": { "type": "integer", "minimum": 1, "maximum": 5000000 },
        "payload_sha256": { "type": "string", "minLength": 16 },
        "overview": {
          "type": "object",
          "required": [
            "nodes",
            "edges",
            "within_target_12_28",
            "dto_bytes",
            "dto_sha256",
            "adapter_element_count",
            "crossings_approx"
          ],
          "additionalProperties": false,
          "properties": {
            "nodes": { "type": "integer", "minimum": 1, "maximum": 40 },
            "edges": { "type": "integer", "minimum": 0, "maximum": 60 },
            "within_target_12_28": { "type": "boolean" },
            "dto_bytes": { "type": "integer", "minimum": 1 },
            "dto_sha256": { "type": "string", "minLength": 16 },
            "adapter_element_count": { "type": "integer", "minimum": 1 },
            "crossings_approx": { "type": "integer", "minimum": 0 }
          }
        },
        "cumulative_overview": {
          "type": "object",
          "required": ["cap_enforced", "nodes", "edges"],
          "additionalProperties": false,
          "properties": {
            "cap_enforced": { "type": "boolean" },
            "nodes": { "type": "integer", "minimum": 0 },
            "edges": { "type": "integer", "minimum": 0 }
          }
        },
        "expansion": {
          "type": "object",
          "required": ["family", "work", "conflict", "episode_events", "clues", "locations", "evidence"],
          "additionalProperties": false,
          "properties": {
            "family": { "$ref": "#/$defs/expansion_entry" },
            "work": { "$ref": "#/$defs/expansion_entry" },
            "conflict": { "$ref": "#/$defs/expansion_entry" },
            "episode_events": { "$ref": "#/$defs/expansion_entry" },
            "clues": { "$ref": "#/$defs/expansion_entry" },
            "locations": { "$ref": "#/$defs/expansion_entry" },
            "evidence": { "$ref": "#/$defs/expansion_entry" }
          }
        },
        "focus": {
          "type": "object",
          "required": ["nodes", "edges"],
          "additionalProperties": false,
          "properties": {
            "nodes": { "type": "integer", "minimum": 1, "maximum": 20 },
            "edges": { "type": "integer", "minimum": 0 }
          }
        },
        "episode_switch": {
          "type": "object",
          "required": [
            "added_nodes",
            "removed_nodes",
            "unchanged_nodes",
            "added_edges",
            "removed_edges",
            "shared_characters",
            "displacement",
            "cap_enforced"
          ],
          "additionalProperties": false,
          "properties": {
            "added_nodes": { "type": "array", "items": { "type": "string" } },
            "removed_nodes": { "type": "array", "items": { "type": "string" } },
            "unchanged_nodes": { "type": "array", "items": { "type": "string" } },
            "added_edges": { "type": "array", "items": { "type": "string" } },
            "removed_edges": { "type": "array", "items": { "type": "string" } },
            "shared_characters": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "displacement": { "type": "number", "minimum": 0, "maximum": 0 },
            "cap_enforced": { "type": "boolean" }
          }
        },
        "gates": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/gate" } }
      }
    },
    "expansion_entry": {
      "type": "object",
      "required": ["additions", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "additions": { "type": "integer", "minimum": 0, "maximum": 25 },
        "nodes": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 }
      }
    },
    "gate": {
      "type": "object",
      "required": ["name", "passed", "value", "limit", "note"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "passed": { "type": "boolean" },
        "value": {},
        "limit": {},
        "note": { "type": "string" }
      }
    },
    "observation": {
      "type": "object",
      "required": ["metric", "value", "unit", "environment_sensitive", "rationale"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string" },
        "value": {},
        "unit": { "type": "string" },
        "environment_sensitive": { "const": true },
        "rationale": { "type": "string", "minLength": 20 }
      }
    }
  }
}
